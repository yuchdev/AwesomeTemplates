{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift package resolve:*)",
      "Bash(xcodebuild -list:*)",
      "Bash(cmake --build:*)",
      "Bash(ctest:*)",
      "Bash(codesign --verify:*)",
      "Bash(codesign -d:*)",
      "Bash(codesign -dv:*)",
      "Bash(spctl --assess:*)",
      "Bash(xcrun stapler validate:*)",
      "Bash(pkgutil --check-signature:*)",
      "Bash(lipo -archs:*)",
      "Bash(otool -L:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.dmp)",
      "Read(./prototype/*.db)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.mobileprovision)",
      "Read(./**/*.provisionprofile)",
      "Read(./**/*.keychain)",
      "Read(./**/*.keychain-db)",
      "Read(./**/AuthKey_*.p8)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/secret_scan.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/doc_link_check.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/github_audit.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/doc_link_check.py"
          }
        ]
      }
    ]
  }
}
